# Progetto
/docs/superpowers/.tmp
.DS_Store
/.code-review-graph
CLAUDE.md
.claude/

# Asset dei pannelli Filament: generati da `php artisan filament:assets`,
# rigenerati a ogni deploy. Non vanno versionati.
/public/css/filament
/public/js/filament

# Gli asset che i plugin di Filament pubblicano con `filament:assets`, un
# nome di cartella per pacchetto. Si rigenerano a ogni rilascio — il comando
# e' nel deploy — e committarli significherebbe portarsi dietro 4 MB di file
# generati che divergono dalla versione del pacchetto installato.
/public/css/guava
/public/js/guava
/public/fonts/filament
/public/storage

# Artefatti degli strumenti di sviluppo (Playwright MCP)
.playwright-mcp

# Referti di Lighthouse: sono la misura di un momento, non parte del progetto
/storage/lighthouse
# Le locandine e le copertine caricate: sono contenuto di chi usa il sito, non
# codice. In produzione stanno sul disco del server, in locale sono i file
# seminati per le prove — in nessuno dei due casi appartengono al repository.
/storage/media-library

# Rapporti di Lighthouse: si rigenerano a ogni misura
/.lighthouseci
# Schermate e registri delle prove col browser
/.playwright-mcp
# Schermate di lavorazione lasciate in radice
/*.png
# Archivi di trasferimento: si cancellano nella sessione in cui si usano
/*.zip
/android/app/google-services.json
/android/app/src/debug/google-services.json
/android/app/src/release/google-services.json
*firebase-adminsdk*.json
/storage/app/private/firebase/

# Referti e schermate generati dalle suite di qualità
/tests/Browser/Screenshots/
/.deptrac.cache
/.infection/
