# Ogni copia di lavoro del .env: contengono APP_KEY e le credenziali del
# database, e finora bastava un nome fuori elenco (.env.prima-di-qualcosa) per
# renderle committabili. Si elencano gli ammessi, non gli esclusi.
.env.*
!.env.example
