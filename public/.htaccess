# ---------------------------------------------------------------------------
# Versione PHP (hosting cPanel)
#
# L'applicazione richiede PHP >= 8.4.1. Sul target di deploy attuale
# (cPanel/CloudLinux) l'interruttore MultiPHP del pannello risulta impostato su
# ea-php84 ma il web continua a essere servito da 8.3, e Composer rifiuta di
# avviarsi. Questa direttiva forza l'handler corretto per directory.
#
# Deve stare QUI, nel file versionato: il deploy sincronizza public/ con
# --delete, quindi una direttiva aggiunta a mano sul server viene cancellata
# al primo rilascio successivo. E' gia successo una volta.
#
# Su un host non cPanel questo handler non esiste: rimuovere il blocco al
# momento della migrazione, altrimenti Apache servirebbe i .php come file da
# scaricare.
# ---------------------------------------------------------------------------
<IfModule mime_module>
    AddType application/x-httpd-ea-php84 .php .php8 .phtml
</IfModule>

Options -Indexes

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews
    </IfModule>

    RewriteEngine On

    # Vite filenames are content hashed; only these assets are immutable.
    RewriteRule ^build/assets/ - [E=INCITTA_VERSIONED_ASSET:1]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(?:css|js|mjs|json|jpg|jpeg|png|gif|webp|avif|heic|svg|ico|woff|woff2|ttf)$">
        Header always set X-Content-Type-Options "nosniff"
        Header always set X-Frame-Options "SAMEORIGIN"
    </FilesMatch>
    Header set Cache-Control "public, max-age=31536000, immutable" env=INCITTA_VERSIONED_ASSET
</IfModule>
