APP_NAME="inCittà"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=it
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=it_IT

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=eventi_local
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# In sviluppo: `log` scrive i messaggi in storage/logs/laravel.log, ma leggere
# un HTML dentro un log e' penoso. Con Mailpit avviato (`brew services start
# mailpit`) si mette `smtp` sulla porta 1025 e la casella si guarda su
# http://127.0.0.1:8025 — e la cifratura va lasciata vuota, altrimenti la
# connessione fallisce. Vedi «Vedere le email in sviluppo» nel RUNBOOK.
#
# In produzione questi valori restano la riserva: se un super amministratore
# configura un server SMTP dal pannello e lo attiva, vince quello (D50).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Notifiche push del browser (§15.6, D54).
#
# Si generano una volta con `php artisan webpush:vapid` e non si cambiano piu':
# il browser lega ogni iscrizione alla chiave pubblica con cui e' stata chiesta,
# quindi rigenerarle invalida in un colpo solo tutti i dispositivi iscritti.
#
# Lasciate vuote il canale push non esiste e tutto esce per email — che e' il
# ripiego previsto da §15.6, non un guasto: e' cosi' che gira in sviluppo.
#
# VAPID_SUBJECT e' come il servizio push raggiunge chi manda: `mailto:` o
# l'indirizzo del sito. Vuoto, il pacchetto usa APP_URL.
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Piattaforma eventi ---
SCOUT_DRIVER=database
CITY_DEFAULT_SLUG=padova
MAP_TILES_URL=https://services.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Dark_Gray_Base/MapServer/tile/{z}/{y}/{x}
MAP_ATTRIBUTION="© OpenStreetMap contributors, Esri"

# --- API v1 (§13) ---
# Versione minima dell'app dichiarata da GET /v1/config.
API_MIN_APP_VERSION_IOS=1.0.0
API_MIN_APP_VERSION_ANDROID=1.0.0
# Versione mostrata nella documentazione OpenAPI su /docs/api.
API_VERSION=1.0.0
# Dove porta il collegamento "reimposta la password" del messaggio:
# {token} e {email} vengono sostituiti. Senza, punta al sito.
API_PASSWORD_RESET_URL=
# Testi legali mostrati dall'app: finché sono vuoti, GET /v1/config li dà null.
API_LEGAL_TERMS_URL=
API_LEGAL_PRIVACY_URL=
API_LEGAL_UPDATED_AT=

# --- Media, SEO e cache (§12) ---
# Motore immagini della pipeline: Imagick sul server ha HEIC e AVIF compilati,
# GD non li conosce. Con `gd` la pipeline resta in piedi ma perde quei formati.
IMAGE_DRIVER=imagick
MEDIA_DISK=public
# Rete di distribuzione delle immagini. Vuota: gli indirizzi restano quelli del
# disco. Riempita: ogni media e ogni variante escono da quel dominio.
MEDIA_CDN_URL=
# Anteprima social 1200x630 (§12.1). Spegnerla dove non c'è ImageMagick.
MEDIA_OG_ENABLED=true
MEDIA_OG_FONT=resources/fonts/og-title.ttf
MEDIA_OG_TEXT_FONT=resources/fonts/og-text.ttf
# File di logo da comporre nell'anteprima. Vuoto: si disegna il nome del sito.
MEDIA_OG_LOGO=
# Full-page cache dello scheletro (§12.3). Da spegnere in sviluppo se si vuole
# vedere ogni modifica alle viste senza aspettare i cinque minuti.
PAGE_CACHE_ENABLED=true
# Profilo X/Twitter del sito, per `twitter:site`. Vuoto: la riga non esce.
SEO_TWITTER_SITE=
# Nodo JSON-LD `Organization` della pagina iniziale.
SEO_ORGANIZATION=
SEO_ORGANIZATION_EMAIL=
SEO_ORGANIZATION_SOCIALS=

# --- Anti-abuso (§14.7) ---
# Cloudflare Turnstile sui moduli pubblici: proponi evento, registra il tuo
# locale, segnalazione, registrazione. **Vuote = spento**: nessun riquadro nel
# modulo e nessuna regola in validazione, così sviluppo, test e CI non
# dipendono da un servizio esterno raggiungibile. Vanno riempite entrambe:
# con una sola, la protezione resta spenta.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_TIMEOUT=5

# --- Archiviazione degli scaduti (§14.5) ---
# Da quanti giorni devono essere passate TUTTE le date di un evento perché
# `events:archive` lo tolga dalle liste. La pagina resta raggiungibile e
# l'evento resta nell'archivio del locale: cambia solo la visibilità in elenco.
EVENTS_ARCHIVE_AFTER_DAYS=90

# --- Operatività e monitoraggio (§16) ---
# Indirizzo a cui arrivano TUTTI gli allarmi di esercizio: backup fallito,
# controllo di stato rosso, comando schedulato che ha smesso di girare.
# **Vuoto = nessun allarme parte**: Laravel salta un canale senza destinazione.
OPS_ALERT_EMAIL=
# Chiave dell'endpoint di stato `/stato` e `/stato/completo`. Si passa
# nell'intestazione `X-Secret-Token` oppure come `?token=`. **Vuota, l'endpoint
# risponde 404 a chiunque**: un elenco di ciò che sta cedendo non si lascia
# aperto. Generarla con `php artisan key:generate --show`.
OPS_HEALTH_TOKEN=
# Backup (§16). `BACKUP_DISKS` sono i dischi di `config/filesystems.php`
# separati da virgola: `local` sul server cPanel, che non ha S3 configurato.
# Quando esisterà un bucket: `local,s3` con le credenziali AWS_* qui sopra.
BACKUP_NAME=eventi
BACKUP_DISKS=local
# Password dell'archivio. Vuota = archivio in chiaro. Se la si imposta, va
# conservata dove si conservano i segreti: senza, il backup non si riapre.
BACKUP_ARCHIVE_PASSWORD=
# Indirizzo esterno da contattare quando lo scheduler risulta vivo ("dead man's
# switch"). Vuoto: nessun trasferimento verso terzi.
SCHEDULE_HEARTBEAT_URL=

# --- Interruttori di funzione (Pennant) ---
# Valore predefinito per un ambito su cui nessuno ha ancora deciso: una città
# appena creata, un sistema appena installato. Da lì in poi comanda la riga in
# `features`, che si scrive con `php artisan feature:set`.
FEATURE_CITY_IMPORT=true
FEATURE_NEWSLETTER=true

# --- Tracciamento errori (§16) ---
# **Vuoto = Sentry spento**: il pacchetto non si avvia affatto, non apre alcuna
# connessione e non solleva alcuna eccezione. Vale anche per GlitchTip, che
# parla lo stesso protocollo: cambia solo il DSN.
SENTRY_LARAVEL_DSN=
# Rilascio a cui attribuire gli errori: lo riempie la pipeline con lo sha.
SENTRY_RELEASE=
SENTRY_ENVIRONMENT=
# Frazione di richieste di cui misurare le prestazioni. Vuoto = nessuna: su una
# shared hosting il costo della misura si paga sulla richiesta misurata.
SENTRY_TRACES_SAMPLE_RATE=

# --- Analitica senza cookie e consenso (§16) ---
# **Le tre variabili vuote = nessuna analitica.** Non uno script spento: nessun
# tag, nessuna richiesta verso un altro dominio, niente. È lo stato predefinito
# del progetto, ed è quello con cui girano test e CI.
#
# `ANALYTICS_PROVIDER` è `plausible` oppure `umami` — un valore diverso spegne
# tutto invece di produrre uno script a metà.
# `ANALYTICS_DOMAIN` è il dominio per Plausible (`data-domain`) e
# l'identificativo del sito per Umami (`data-website-id`): quale attributo
# emettere lo sa `App\Enums\AnalyticsProvider`.
# `ANALYTICS_SRC` è l'indirizzo completo dello script sul proprio server di
# statistiche, e deve essere `https`.
#
# Lo script viene caricato **solo** se le variabili ci sono E chi sta guardando
# ha acconsentito: chi non ha ancora scelto vale come chi ha rifiutato.
ANALYTICS_PROVIDER=
ANALYTICS_DOMAIN=
ANALYTICS_SRC=
# La versione dell'informativa a cui si riferisce il consenso registrato.
# Cambiandola, ogni scelta espressa prima torna a valere come "non espressa" e
# il banner ricompare: è il solo modo di far valere davvero un cambiamento
# delle finalità.
CONSENT_VERSION=2026-08-31

# Rilascio (`deploy:pull`). Vuoti significa «cerca nei posti soliti»: servono
# solo dove gli strumenti stanno fuori dall'ordinario. Il rilascio parte da un
# processo PHP, che non legge il profilo della shell — quindi un `npm`
# installato nella home e aggiunto al PATH dal `.bashrc` non lo trova.
DEPLOY_PHP_BINARY=
DEPLOY_NPM_BINARY=
DEPLOY_COMPOSER_BINARY=
