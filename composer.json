{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "ext-bcmath": "*",
        "ext-curl": "*",
        "ext-dom": "*",
        "ext-exif": "*",
        "ext-fileinfo": "*",
        "ext-gd": "*",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-zip": "*",
        "barryvdh/laravel-dompdf": "^3.1",
        "dedoc/scramble": "^0.13.42",
        "filament/filament": "^5.0",
        "filament/spatie-laravel-media-library-plugin": "^5.7",
        "flowframe/laravel-trend": "^0.5.0",
        "geocoder-php/nominatim-provider": "^5.8",
        "guava/calendar": "^3.2",
        "intervention/image": "^3.11",
        "kornrunner/blurhash": "^1.2",
        "laravel-notification-channels/fcm": "^6.1",
        "laravel-notification-channels/webpush": "^12.1",
        "laravel/framework": "^13.17",
        "laravel/pennant": "^1.26",
        "laravel/sanctum": "^4.3",
        "laravel/scout": "^11.5",
        "laravel/tinker": "^3.0",
        "matanyadaev/laravel-eloquent-spatial": "^4.8",
        "propaganistas/laravel-phone": "^6.0",
        "pxlrbt/filament-excel": "^4.1",
        "rlanvin/php-rrule": "^3.0",
        "sabre/vobject": "^5.0",
        "sentry/sentry-laravel": "^4.27",
        "simplesoftwareio/simple-qrcode": "^4.2",
        "spatie/calendar-links": "^2.1",
        "spatie/icalendar-generator": "^3.3",
        "spatie/image": "^3.9",
        "spatie/laravel-activitylog": "^5.1",
        "spatie/laravel-backup": "^10.3",
        "spatie/laravel-health": "^1.40",
        "spatie/laravel-medialibrary": "^11.23",
        "spatie/laravel-missing-page-redirector": "^2.12",
        "spatie/laravel-permission": "^8.3",
        "spatie/laravel-query-builder": "^7.3",
        "spatie/laravel-schedule-monitor": "^4.3",
        "spatie/laravel-settings": "^3.9",
        "spatie/laravel-sitemap": "^8.2",
        "spatie/laravel-sluggable": "^4.0",
        "typesense/typesense-php": "^6.0"
    },
    "require-dev": {
        "deptrac/deptrac": "^4.7",
        "fakerphp/faker": "^1.23",
        "infection/infection": "^0.35.4",
        "larastan/larastan": "^3.10",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "laravel/telescope": "^5.23",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^4.7",
        "pestphp/pest-plugin-browser": "^4.3",
        "pestphp/pest-plugin-laravel": "^4.1",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install --ignore-scripts",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "test:unit": "@php vendor/bin/pest --testsuite=Unit",
        "test:feature": "@php vendor/bin/pest --testsuite=Feature",
        "test:arch": "@php vendor/bin/pest --testsuite=Architecture",
        "test:browser": "@php vendor/bin/pest --configuration=phpunit.browser.xml",
        "analyse": "@php vendor/bin/phpstan analyse --memory-limit=1G --no-progress",
        "analyse:max": "@php vendor/bin/phpstan analyse --configuration=phpstan-max.neon --memory-limit=2G --no-progress",
        "architecture": "@php vendor/bin/deptrac analyse --no-progress",
        "mutation": "@php vendor/bin/infection app/Support/SafeUrl.php --with-uncovered --test-framework-options=\"--testsuite=Unit\" --threads=2 --min-msi=80 --min-covered-msi=90"
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "infection/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
